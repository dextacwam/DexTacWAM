 class Tee:
+    """File-like stream that mirrors writes to multiple underlying files.
+
+    The first file is treated as the "primary" stream (typically sys.__stdout__
+    or sys.__stderr__) and is the source of truth for file-system properties
+    such as ``isatty()`` / ``fileno()``. Any library that introspects the
+    stream (e.g. wandb's progress-bar logic, which calls ``sys.stderr.isatty()``
+    inside ``wandb.run.finish()``) gets a sensible answer and doesn't crash
+    on AttributeError.
+    """
+
     def __init__(self, *files):
         self.files = files
+
     def write(self, obj):
         for f in self.files:
             f.write(obj)
             f.flush()
+
     def flush(self):
         for f in self.files:
             f.flush()
 
+    def isatty(self):
+        primary = self.files[0] if self.files else None
+        if primary is not None and hasattr(primary, "isatty"):
+            try:
+                return primary.isatty()
+            except Exception:
+                return False
+        return False
+
+    def fileno(self):
+        primary = self.files[0] if self.files else None
+        if primary is not None and hasattr(primary, "fileno"):
+            return primary.fileno()
+        raise OSError("Tee primary stream has no fileno")
+
+    @property
+    def closed(self):
+        return all(getattr(f, "closed", False) for f in self.files)
+
+    def writable(self):
+        return True
+
+    def readable(self):
+        return False
+
+    def seekable(self):
+        return False
+
