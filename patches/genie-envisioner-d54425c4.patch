+    def _split_action_kv(
+        self,
+        final_hidden_states: torch.Tensor,
+        n_view: int,
+        n_view_visual: Optional[int] = None,
+    ) -> Tuple[torch.Tensor, Optional[torch.Tensor]]:
+        """Split the (b, V*L, c) action-block K/V into visual and tactile halves.
+
+        The trainer concatenates tactile views AFTER visual views along the
+        batch axis (see runner/tactile_dit_trainer.py near the
+        `torch.cat([latents, tac_full], dim=0)` line), so after the
+        `(b v) l c -> b (v l) c` rearrange the first `n_view_visual * L`
+        tokens are visual and the remaining `n_view_tactile * L` are tactile.
+
+        Return semantics:
+          - `dual_cross_attn=False`:
+                always `(final_hidden_states, None)`. The action block
+                consumes the full sequence via its legacy `attn2`, so the
+                existing path is bit-for-bit unchanged.
+          - `dual_cross_attn=True` + tactile present
+                (n_view_visual is set AND n_view_visual < n_view):
+                returns `(visual_part, tactile_part)`; the action block
+                routes them through `attn2_visual` and a sigmoid-gated
+                `attn2_tactile` residual respectively.
+          - `dual_cross_attn=True` + tactile absent
+                (n_view_visual is None OR n_view_visual >= n_view):
+                returns `(full_states, None)`. The action block runs only
+                its `attn2_visual` path (visual cross-attn) and skips the
+                tactile residual entirely. This is the correct fallback
+                for the validation / `pipe.infer` path (which does NOT
+                feed tactile views), and matches how Probe K behaves at
+                inference -- no tactile context is injected, so the
+                dual-attn model should reduce to single visual cross-attn,
+                NOT raise. Without this graceful degradation, every
+                `steps_to_val` train step would crash the run.
+        """
+        if not self.dual_cross_attn:
+            return final_hidden_states, None
+        # Graceful fallback for inference / no-tactile val: no split, no
+        # tactile residual. ActionTransformerBlock.forward checks for None
+        # and skips its `attn2_tactile` branch.
+        if n_view_visual is None or n_view_visual >= n_view:
+            return final_hidden_states, None
+        L_per_view = final_hidden_states.shape[1] // n_view
+        n_vis_tokens = n_view_visual * L_per_view
+        final_visual = final_hidden_states[:, :n_vis_tokens, :]
+        final_tactile = final_hidden_states[:, n_vis_tokens:, :]
+        # Probe N: action_visual_only override. After the legitimate visual /
+        # tactile split, drop the tactile half so the action expert receives
+        # ONLY visual K/V. The WM backbone forward above is unchanged; tactile
+        # tokens still pass through every transformer_block. This catches both
+        # call sites in `forward` (grad-checkpoint + regular path) via a
+        # single point of control. ActionTransformerBlock.forward sees
+        # `encoder_hidden_states_tactile=None` and skips its `attn2_tactile`
+        # branch entirely -- zero compute on the tactile attention, zero
+        # residual contribution, zero gradient into the tactile branch. See
+        # plan probe-n-action-visual-only_ab4dedf4 for the J/K/M/N decision
+        # matrix.
+        if self.action_visual_only:
+            return final_visual, None
+        return final_visual, final_tactile
+
+
+    def _apply_action_kv_norm(
+        self,
+        final_hidden_states: torch.Tensor,
+        block_idx: int,
+        n_view: int,
+        n_view_visual: Optional[int] = None,
+        action_batch_size: Optional[int] = None,
+    ) -> torch.Tensor:
+        """Apply per-modality RMSNorm to the action cross-attention KV.
+
+        Position in the pipeline: this helper runs on the **concatenated**
+        ``(B, V*L, D)`` KV tensor right after the ``(b v) l c -> b (v l) c``
+        rearrange and **before** ``_split_action_kv`` (which is purely a
+        slicing concern). The helper has a single responsibility -- normalize
+        the vision and tactile token segments independently -- and returns a
+        same-shape tensor with the per-segment normalization applied in
+        place along the sequence axis::
+
+            input  (B, V*L, D) = [n_view_visual * L vision | n_view_tactile * L tactile]
+                                              |                         |
+                                              v                         v
+                                  kv_norm_visual[block_idx]   kv_norm_tactile[block_idx]
+                                              |                         |
+                                              v                         v
+            output (B, V*L, D) = [vision_normed                | tactile_normed       ]
+
+        Args:
+            final_hidden_states: concatenated KV after ``(b v) l c ->
+                b (v l) c``, shape ``(B, V*L, D)``. Vision tokens come
+                first (indices ``0 .. n_view_visual * L - 1``), tactile
+                tokens follow.
+            block_idx: which action transformer layer this is for; selects
+                the matching ``ModuleList`` entry.
+            n_view: ``n_view_visual + n_view_tactile`` -- the ``n_view``
+                local in ``forward()``. Used to compute
+                ``tokens_per_view = seq_len // n_view`` with a divisibility
+                assert so a wrong ``n_view`` upstream crashes here rather
+                than silently mis-splitting.
+            n_view_visual: number of vision views (``1`` for head camera).
+                If ``None`` or ``>= n_view`` (e.g. inference paths with no
+                tactile), the helper is a no-op -- there is no tactile
+                slice to normalize and forcing a split would be wrong.
+            action_batch_size: optional defensive guard. If provided, the
+                helper asserts ``final_hidden_states.shape[0] ==
+                action_batch_size`` -- catches a silent upstream bug that
+                breaks the ``(b v) -> b (v l)`` batch-major contract.
+
+        Returns:
+            Tensor with shape identical to ``final_hidden_states``. When
+            ``self.action_kv_rmsnorm`` is ``False`` or there is no tactile
+            slice to normalize, the input is returned unchanged
+            (zero-cost no-op).
+        """
+        if not getattr(self, "action_kv_rmsnorm", False):
+            return final_hidden_states
+
+        # Batch-dim consistency guard: catches an upstream silent bug that
+        # breaks the (b v) -> b (v l) batch-major contract.
+        if action_batch_size is not None:
+            assert final_hidden_states.shape[0] == action_batch_size, (
+                f"[action_kv_rmsnorm] KV batch dim "
+                f"{final_hidden_states.shape[0]} != action batch dim "
+                f"{action_batch_size}; check n_view passing at the "
+                f"'(b v) l c -> b (v l) c' rearrange site"
+            )
+
+        # Inference / no-context fallback (e.g. pipe.infer with no view-count
+        # info): no split, no norm. Mirrors _split_action_kv's most-graceful
+        # fallback so the two helpers compose cleanly.
+        if n_view_visual is None:
+            return final_hidden_states
+
+        # Training-time visual-only fallback (n_view_visual == n_view, e.g.
+        # V=3 head+L_wrist+R_wrist with `use_tactile_views: false`). The
+        # original per-modality split has no tactile slice to normalize, so
+        # by default we no-op (preserves bit-for-bit backward-compat with
+        # every previously-trained tactile-on ckpt). When
+        # `action_kv_rmsnorm_visual_only_mode=True` is set in the yaml's
+        # `diffusion_model.config`, apply a single per-block RMSNorm
+        # (`kv_norm_visual[block_idx]`) to the entire visual KV. The matching
+        # `kv_norm_tactile[block_idx]` module is constructed (per the
+        # `action_kv_rmsnorm=True` branch above) but unused in this branch.
+        if n_view_visual >= n_view:
+            if getattr(self, "action_kv_rmsnorm_visual_only_mode", False):
+                return self.kv_norm_visual[block_idx](final_hidden_states)
+            return final_hidden_states
+
+        seq_len = final_hidden_states.shape[1]
+        assert n_view > 0, (
+            f"[action_kv_rmsnorm] n_view must be > 0; got {n_view}"
+        )
+        assert seq_len % n_view == 0, (
+            f"[action_kv_rmsnorm] KV seq_len={seq_len} not divisible by "
+            f"n_view={n_view}"
+        )
+        tokens_per_view = seq_len // n_view
+        visual_len = n_view_visual * tokens_per_view
+        assert 0 < visual_len < seq_len, (
+            f"[action_kv_rmsnorm] degenerate visual_len={visual_len} "
+            f"(seq_len={seq_len}, n_view_visual={n_view_visual}, "
+            f"n_view={n_view})"
+        )
+
+        visual_part = final_hidden_states[:, :visual_len]
+        tactile_part = final_hidden_states[:, visual_len:]
+
+        if (not self._kv_split_logged) and block_idx == 0:
+            try:
